{
  "manifest_version": 3,
  "name": "Frendz · Passport / ID Autofill",
  "version": "0.2.0",
  "description": "Reads a passport/ID MRZ locally and auto-fills the Mews guest profile. Frendz Hostel El Nido. Local only — nothing is sent anywhere.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Frendz · Passport / ID Autofill",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
